<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="renathyu0015.proyectojavafx.LoginController">

    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <children>
        <Label text="Iniciar sesión">
            <style>
                -fx-font-size: 22px;
                -fx-font-weight: bold;
            </style>
        </Label>

        <TextField fx:id="txtCorreo" promptText="Correo electrónico" />

        <PasswordField fx:id="txtClave" promptText="Contraseña" />

        <Button onAction="#ingresar" text="Ingresar" defaultButton="true" />

        <Label fx:id="lblMensaje" textFill="RED" />
    </children>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="450.0"
            prefWidth="600.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="renathyu0015.proyectojavafx.RegisterController">

    <children>
        <VBox alignment="TOP_CENTER"
              layoutX="125.0"
              layoutY="25.0"
              prefWidth="350.0"
              spacing="12.0"
              style="-fx-background-color: white;">

            <padding>
                <Insets top="25.0" right="25.0"
                        bottom="25.0" left="25.0"/>
            </padding>

            <children>
                <Label text="Crear una cuenta"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>

                <Label text="Completa tus datos para registrarte"
                       style="-fx-font-size: 13px; -fx-text-fill: #64748B;"/>

                <TextField fx:id="txtNombre"
                           promptText="Nombre"
                           prefWidth="300.0"
                           prefHeight="38.0"/>

                <TextField fx:id="txtApellido"
                           promptText="Apellido"
                           prefWidth="300.0"
                           prefHeight="38.0"/>

                <TextField fx:id="txtCorreo"
                           promptText="Correo electrónico"
                           prefWidth="300.0"
                           prefHeight="38.0"/>

                <PasswordField fx:id="txtClave"
                               promptText="Contraseña"
                               prefWidth="300.0"
                               prefHeight="38.0"/>

                <PasswordField fx:id="txtConfirmarClave"
                               promptText="Confirmar contraseña"
                               prefWidth="300.0"
                               prefHeight="38.0"/>

                <Button fx:id="btnRegistrarse"
                        mnemonicParsing="false"
                        text="Registrarse"
                        prefWidth="300.0"
                        prefHeight="40.0"
                        onAction="#registrar"
                        style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand;"/>

                <Label fx:id="lblMensaje"
                       text=""
                       wrapText="true"
                       style="-fx-font-size: 13px;"/>
            </children>
        </VBox>
    </children>
</AnchorPane>



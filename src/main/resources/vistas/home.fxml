<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0"
      alignment="TOP_CENTER"
      style="-fx-background-color: #F2F5F9;"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="renathyu0015.proyectojavafx.controladores.HomeController">

    <padding>
        <Insets top="24.0" right="28.0" bottom="24.0" left="28.0"/>
    </padding>

    <!-- Encabezado -->
    <VBox spacing="7.0"
          alignment="CENTER_LEFT"
          style="-fx-background-color: #17365D; -fx-background-radius: 8;">

        <padding>
            <Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/>
        </padding>

        <Label text="SISTEMA DE GESTIÓN DE AULAS"
               style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: white;"/>

        <Label text="Administración de espacios académicos"
               style="-fx-font-size: 12px; -fx-text-fill: #D8E4F2;"/>

        <Label fx:id="lblBienvenida"
               text="Bienvenido"
               style="-fx-font-size: 14px; -fx-text-fill: white;"/>
    </VBox>

    <!-- Formulario -->
    <VBox spacing="18.0"
          style="-fx-background-color: white; -fx-background-radius: 8;">

        <padding>
            <Insets top="22.0" right="24.0" bottom="22.0" left="24.0"/>
        </padding>

        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Region prefWidth="4.0" minWidth="4.0"
                    style="-fx-background-color: #5B9BD5; -fx-background-radius: 2;"/>
            <VBox spacing="4.0">
                <Label text="Información del aula"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #17365D;"/>
                <Label text="Complete los datos del espacio académico."
                       style="-fx-font-size: 12px; -fx-text-fill: #667085;"/>
            </VBox>
        </HBox>

        <GridPane hgap="18.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Nombre del aula"
                   style="-fx-font-weight: bold; -fx-text-fill: #344054;"
                   GridPane.columnIndex="0" GridPane.rowIndex="0"/>

            <Label text="Edificio"
                   style="-fx-font-weight: bold; -fx-text-fill: #344054;"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <TextField fx:id="txtNombre"
                       promptText="Ej. Aula 101"
                       maxWidth="Infinity"
                       GridPane.columnIndex="0" GridPane.rowIndex="1"/>

            <TextField fx:id="txtEdificio"
                       promptText="Nombre del edificio"
                       maxWidth="Infinity"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Planta"
                   style="-fx-font-weight: bold; -fx-text-fill: #344054;"
                   GridPane.columnIndex="0" GridPane.rowIndex="2"/>

            <Label text="Capacidad"
                   style="-fx-font-weight: bold; -fx-text-fill: #344054;"
                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <ComboBox fx:id="cmbPlanta"
                      promptText="Seleccionar planta"
                      maxWidth="Infinity"
                      GridPane.columnIndex="0" GridPane.rowIndex="3"/>

            <TextField fx:id="txtCapacidad"
                       promptText="Número de estudiantes"
                       maxWidth="Infinity"
                       GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="Tipo de aula"
                   style="-fx-font-weight: bold; -fx-text-fill: #344054;"
                   GridPane.columnIndex="0" GridPane.rowIndex="4"/>

            <Label text="Responsable"
                   style="-fx-font-weight: bold; -fx-text-fill: #344054;"
                   GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <ComboBox fx:id="cmbTipoAula"
                      promptText="Seleccionar tipo"
                      maxWidth="Infinity"
                      GridPane.columnIndex="0" GridPane.rowIndex="5"/>

            <TextField fx:id="txtResponsable"
                       promptText="Nombre completo"
                       maxWidth="Infinity"
                       GridPane.columnIndex="1" GridPane.rowIndex="5"/>

            <Label text="Estado del aula"
                   style="-fx-font-weight: bold; -fx-text-fill: #344054;"
                   GridPane.columnIndex="0" GridPane.rowIndex="6"/>

            <ComboBox fx:id="cmbEstado"
                      promptText="Seleccionar estado"
                      maxWidth="Infinity"
                      GridPane.columnIndex="0" GridPane.rowIndex="7"/>
        </GridPane>

        <HBox spacing="12.0" alignment="CENTER_RIGHT">
            <Button fx:id="btnLimpiar"
                    text="Limpiar"
                    style="-fx-background-color: #E8EDF3; -fx-text-fill: #17365D; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 9 18;"/>

            <Button fx:id="btnGuardar"
                    text="Guardar aula"
                    style="-fx-background-color: #17365D; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 9 18;"/>
        </HBox>
    </VBox>

    <!-- Cerrar sesión -->
    <HBox alignment="CENTER_RIGHT">
        <Button text="Cerrar sesión"
                onAction="#cerrarSesion"
                style="-fx-background-color: transparent; -fx-text-fill: #17365D; -fx-underline: true;"/>
    </HBox>

</VBox>




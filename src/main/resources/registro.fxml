<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="renathyu0015.proyectojavafx.RegisterController">

    <padding>
        <Insets top="25.0" right="40.0" bottom="25.0" left="40.0"/>
    </padding>

    <children>
        <Label text="Crear una cuenta"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

        <Label text="Completa tus datos para registrarte"
               style="-fx-font-size: 13px; -fx-text-fill: #64748B;"/>

        <TextField fx:id="txtNombre" promptText="Nombre"/>
        <TextField fx:id="txtApellido" promptText="Apellido"/>
        <TextField fx:id="txtCorreo" promptText="Correo electrónico"/>
        <PasswordField fx:id="txtClave" promptText="Contraseña"/>
        <PasswordField fx:id="txtConfirmarClave" promptText="Confirmar contraseña"/>

        <Button fx:id="btnRegistrarse"
                text="Registrarse"
                onAction="#registrar"
                defaultButton="true"
                maxWidth="Infinity"/>

        <Label fx:id="lblMensaje" wrapText="true"/>

        <Hyperlink text="¿Ya tienes cuenta? Inicia sesión"
                   onAction="#irALogin"/>
    </children>
</VBox>